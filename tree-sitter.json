{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vim9",
      "camelcase": "Vim9",
      "title": "Vim9 Script",
      "scope": "source.vim9",
      "file-types": [
        "vim"
      ],
      "injection-regex": "^(vim|vim9|vimscript)$",
      "class-name": "TreeSitterVim9"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "A Vim9-first Tree-sitter grammar",
    "authors": [
      {
        "name": "beamiter",
        "email": "beamiter@163.com"
      }
    ],
    "links": {
      "repository": "https://github.com/beamiter/tree-sitter-vim9"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
